<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="CreditsEntryUi" src="project://database/Assets/MonoBehaviour/CreditsEntryUi.uxml?fileID=9197481963319205126&amp;guid=a4924b20359a06b4e8110dcf89f3ac93&amp;type=3#CreditsEntryUi" />
    <ui:VisualElement name="secondBackground" style='position: absolute; width: 100%; height: 100%; background-image: url("project://database/Assets/MonoBehaviour/thank-you-publicdomainvectors.org.asset?fileID=11400000&amp;guid=100d271bdaf028b46940557044189c7e&amp;type=2#thank-you-publicdomainvectors.org"); -unity-background-scale-mode: scale-and-crop;'>
        <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" name="ScrollView" style="margin-left: 20px; margin-right: 20px; margin-top: 20px;">
            <ui:Label text="Credits summary" display-tooltip-when-elided="true" name="creditsSummaryLabel" style="width: 100%; -unity-text-align: upper-center;" />
        </ui:ScrollView>
    </ui:VisualElement>
    <ui:VisualElement name="background" picking-mode="Ignore" style='width: 100%; height: 100%; background-image: url("project://database/Assets/Sprite/brown-g145e3ab49_1920.asset?fileID=21300000&amp;guid=3ae6bccce483fc74696b82e56cf48a8d&amp;type=2#brown-g145e3ab49_1920"); position: absolute; -unity-background-scale-mode: scale-and-crop;'>
        <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1; align-items: center; justify-content: flex-start; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; width: 100%;">
            <ui:VisualElement name="categoryNameContainer" picking-mode="Ignore" style="width: 100%; align-items: center; position: absolute; height: 100%;">
                <ui:Label text="Credits Category" display-tooltip-when-elided="true" name="categoryNameLabel" class="xxlFont" style="position: absolute; text-shadow: 1px 1px 0 rgb(0, 0, 0); -unity-font-style: bold; border-bottom-width: 2px; border-bottom-color: rgba(255, 255, 255, 0.5); padding-left: 10px; padding-right: 10px; padding-bottom: 5px;" />
            </ui:VisualElement>
            <ui:VisualElement name="topRow" picking-mode="Ignore" style="flex-direction: row; align-items: center; justify-content: space-between; width: 100%; padding-bottom: 10px; display: none;">
                <ui:VisualElement name="titleContainer" style="align-items: flex-start; width: 40%;">
                    <ui:VisualElement name="titleImageAndText" style="flex-direction: row; align-items: center;">
                        <ui:VisualElement name="titleImage" class="titleImage" style='background-image: url("project://database/Assets/MonoBehaviour/ultrastardx-icon-contour.asset?fileID=11400000&amp;guid=78c94b65949306f4aa53d3e0205f787f&amp;type=2#ultrastardx-icon-contour");' />
                        <ui:VisualElement name="titleAndDescription">
                            <ui:Label text="Credits" name="sceneTitle" class="titleText" />
                            <ui:Label text="UltraStar Play" name="sceneTitle" class="titleSubText" style="width: auto;" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="centerContent" picking-mode="Ignore" style="width: 100%; flex-grow: 1; align-items: flex-start;">
                <ui:VisualElement name="entriesContainer" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%;">
                    <ui:Instance template="CreditsEntryUi" name="CreditsEntryUi" />
                </ui:VisualElement>
                <ui:VisualElement name="allCharactersContainer" picking-mode="Ignore" style="position: absolute; width: 100%; height: 100%;" />
                <ui:VisualElement name="player" style="position: absolute; top: 90%; left: 50%;">
                    <ui:VisualElement name="playerImage" style='background-image: url("project://database/Assets/MonoBehaviour/ultrastardx-icon.asset?fileID=11400000&amp;guid=97931ce3358d0454da3e213351758c16&amp;type=2#ultrastardx-icon"); width: 80px; height: 80px; -unity-background-scale-mode: scale-to-fit; position: relative; left: -45px; top: -45px;' />
                </ui:VisualElement>
                <ui:VisualElement name="scoreContainer" style="position: absolute; align-items: center; justify-content: center; width: 100%; top: 100%;">
                    <ui:Label text="99999" display-tooltip-when-elided="true" name="scoreLabel" class="largeFont" style="-unity-font-style: bold; text-shadow: 1px 1px 0 rgb(0, 0, 0); color: rgb(241, 241, 241); -unity-text-align: upper-center;" />
                    <ui:Label text="Chain +1" display-tooltip-when-elided="true" name="bonusLabel" class="smallFont" style="-unity-font-style: bold; text-shadow: 1px 1px 0 rgb(0, 0, 0); color: rgb(15, 255, 0); -unity-text-align: upper-center; position: absolute; top: -100%;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="bottomContent" picking-mode="Ignore" style="flex-grow: 0; width: 100%; justify-content: space-between; align-items: flex-end; flex-direction: row;">
                <ui:Button name="skipButton" value="This is the about text on multiple lines." text="Skip" class="controlMinWidth" />
                <ui:Button name="backButton" value="This is the about text on multiple lines." text="Back" class="controlMinWidth" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
