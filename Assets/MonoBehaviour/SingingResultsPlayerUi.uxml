<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:VisualElement style="width: 100%; height: 100%; flex-direction: row; align-items: flex-start; justify-content: space-between;">
        <ui:VisualElement name="column" picking-mode="Ignore" style="width: 60%; height: 100%; flex-direction: column; align-items: center; flex-grow: 1; justify-content: space-between; flex-shrink: 2;">
            <ui:VisualElement name="row" picking-mode="Ignore" style="flex-direction: row; justify-content: space-around; flex-grow: 1;">
                <ui:VisualElement name="playerImage" picking-mode="Ignore" style='background-image: url("project://database/Assets/Texture2D/FallbackPlayerProfileImage.png?fileID=2800000&amp;guid=9373048be5b6d2c42ac566a9a0a36b54&amp;type=3#FallbackPlayerProfileImage"); align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; flex-grow: 1;' />
                <ui:VisualElement picking-mode="Ignore" style="flex-grow: 1;">
                    <ui:VisualElement name="ratingImage" picking-mode="Ignore" style='background-image: url("project://database/Assets/Sprite/_score_rating_0.asset?fileID=21300000&amp;guid=0a9eabef1f7b3bc4e8975d701ff62654&amp;type=2#[score]rating_0"); align-items: center; justify-content: center; -unity-background-scale-mode: scale-to-fit; flex-grow: 1;' />
                    <ui:Label text="Tone Deaf" display-tooltip-when-elided="true" name="ratingLabel" picking-mode="Ignore" style="-unity-text-align: upper-center;" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="singingResultsScoresContainer" picking-mode="Ignore">
                <ui:Label text="Player 1" display-tooltip-when-elided="true" name="playerNameLabel" picking-mode="Ignore" class="titleText" style="width: 100%;" />
                <ui:VisualElement name="normalNoteScore" picking-mode="Ignore" class="scoreRow" style="flex-direction: row; justify-content: space-between;">
                    <ui:VisualElement name="scoreIcon" picking-mode="Ignore" class="iconImage" style='background-image: url("project://database/Assets/Texture2D/_score_bar_box_dark.png?fileID=2800000&amp;guid=a1365c3bc5997e74baea39e8e5a37ddc&amp;type=3#[score]bar_box_dark");' />
                    <ui:VisualElement name="labels" style="flex-direction: row; justify-content: space-between; flex-grow: 1; margin-left: 10px; flex-wrap: wrap; padding-bottom: 2px;">
                        <ui:Label text="Notes" display-tooltip-when-elided="true" name="scoreName" picking-mode="Ignore" style="height: 100%;" />
                        <ui:Label text="9999" display-tooltip-when-elided="true" name="scoreValue" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="goldenNoteScore" picking-mode="Ignore" class="scoreRow" style="flex-direction: row; justify-content: space-between;">
                    <ui:VisualElement name="scoreIcon" picking-mode="Ignore" class="iconImage" style='background-image: url("project://database/Assets/Texture2D/_score_bar_box_light.png?fileID=2800000&amp;guid=fed13dba4333ef24a974035e7e51ea12&amp;type=3#[score]bar_box_light");' />
                    <ui:VisualElement name="labels" picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; flex-grow: 1; margin-left: 10px; flex-wrap: wrap;">
                        <ui:Label text="Golden Notes" display-tooltip-when-elided="true" name="scoreName" picking-mode="Ignore" />
                        <ui:Label text="9999" display-tooltip-when-elided="true" name="scoreValue" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="phraseBonusScore" picking-mode="Ignore" class="scoreRow" style="flex-direction: row; justify-content: space-between;">
                    <ui:VisualElement name="scoreIcon" picking-mode="Ignore" class="iconImage" style='background-image: url("project://database/Assets/Texture2D/_score_bar_box_lightest.png?fileID=2800000&amp;guid=a60fa48bb1a8fe44285612724588c733&amp;type=3#[score]bar_box_lightest");' />
                    <ui:VisualElement name="labels" picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; flex-grow: 1; margin-left: 10px; flex-wrap: wrap;">
                        <ui:Label text="Phrase Bonus" display-tooltip-when-elided="true" name="scoreName" picking-mode="Ignore" />
                        <ui:Label text="9999" display-tooltip-when-elided="true" name="scoreValue" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="totalScore" style="flex-direction: row; justify-content: space-between; padding-bottom: 5px; padding-left: 5px; padding-right: 5px; padding-top: 5px; width: 100%;">
                <ui:VisualElement name="scoreIcon" picking-mode="Ignore" class="iconImage" style='background-image: url("project://database/Assets/Texture2D/_sing_p.png?fileID=2800000&amp;guid=4cc731ee09421164b8b3ada6b8d54111&amp;type=3#[sing]p");' />
                <ui:VisualElement name="labels" picking-mode="Ignore" style="flex-direction: row; justify-content: space-between; flex-grow: 1; margin-left: 20px;">
                    <ui:Label text="Total" display-tooltip-when-elided="true" name="scoreName" picking-mode="Ignore" />
                    <ui:Label text="99999" display-tooltip-when-elided="true" name="scoreValue" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="column" picking-mode="Ignore" style="height: 100%; flex-grow: 2; width: 10%; flex-shrink: 1; padding-left: 20px; padding-right: 10px;">
            <ui:VisualElement name="scoreBar" picking-mode="Ignore" style="height: 100%; flex-grow: 1;">
                <ui:VisualElement name="emptyScoreBar" picking-mode="Ignore" style='height: 96%; flex-grow: 0; background-image: url("project://database/Assets/Sprite/_score_glass_box.asset?fileID=21300000&amp;guid=f13d3aa669cf87f4990118d9bdec4109&amp;type=2#[score]glass_box"); width: 100%;' />
                <ui:VisualElement name="filledScoreBar" picking-mode="Ignore" style='background-image: url("project://database/Assets/Sprite/_score_endcap.asset?fileID=21300000&amp;guid=077a044e9c74bba43826f4759418cb78&amp;type=2#[score]endcap"); position: absolute; bottom: 0; -unity-background-scale-mode: stretch-to-fill; height: 5%; width: 100%;' />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
